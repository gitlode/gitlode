{
  "name": "@gitlode/plugin-conventional-commits",
  "version": "0.6.0",
  "description": "Official gitlode plugin for parsing conventional commits",
  "keywords": [
    "gitlode",
    "gitlode-plugin",
    "plugin"
  ],
  "homepage": "https://github.com/gitlode/gitlode#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitlode/gitlode.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:dev",
    "build:clean": "tsc -b --clean",
    "build:dev": "tsc -b",
    "build:watch": "tsc -b -w",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run build:dev && vitest run",
    "test:watch": "npm run build:dev && vitest",
    "test:coverage": "npm run build:dev && vitest run --coverage"
  },
  "dependencies": {
    "conventional-commits-parser": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^4.1.10",
    "gitlode": "^0.12.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "gitlode": "^0.12.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

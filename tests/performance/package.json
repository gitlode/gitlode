{
  "name": "@gitlode/performance-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:windows-launcher": "tsc -p tsconfig.windows-launcher.json",
    "test": "vitest run",
    "format:write": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "performance:calibrate": "tsx ./scripts/telemetry-performance-supervised.ts calibrate",
    "performance:capture-legacy": "tsx ./scripts/telemetry-performance-supervised.ts capture-legacy",
    "performance:measure": "tsx ./scripts/telemetry-performance-supervised.ts measure",
    "performance:aggregate": "tsx ./scripts/telemetry-performance-supervised.ts aggregate"
  },
  "devDependencies": {
    "@gitlode/internal-contracts": "0.0.0",
    "@gitlode/internal-foundation": "0.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.13.14",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

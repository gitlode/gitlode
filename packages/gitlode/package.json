{
  "name": "gitlode",
  "version": "0.11.0",
  "description": "Extract Git commit history to JSON Lines (JSONL) for data warehouse ingestion",
  "keywords": [
    "cli",
    "data-warehouse",
    "etl",
    "git",
    "jsonl"
  ],
  "homepage": "https://github.com/gitlode/gitlode#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitlode/gitlode.git"
  },
  "bin": {
    "gitlode": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "default": "./dist/plugin-api.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc --watch",
    "schema:check": "tsx ./scripts/check-generated-config-schema.ts",
    "schema:generate": "tsx ./scripts/generate-config-schema.ts",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:release": "tsdown",
    "release:invalidate": "tsx ./scripts/invalidate-release-cache.ts",
    "validate:output": "tsx ./scripts/validate-release.ts",
    "validate:publint": "publint",
    "validate:types": "attw --pack . --profile esm-only",
    "validate:release": "npm run validate:output && npm run validate:publint && npm run validate:types",
    "test:package": "npm run build:release --prefix ../.. && tsx ./scripts/test-package.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "isomorphic-git": "^1.38.5",
    "semver": "^7.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@types/node": "^22.13.14",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "memfs": "^4.64.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "publint": "^0.3.12",
    "tsdown": "^0.12.9",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
